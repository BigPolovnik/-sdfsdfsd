using System.Globalization;
using System.Net;
using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Text.Json;
using System.Text.Json.Serialization;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;

namespace MoviePlatform.Application;

public sealed class VibixCatalogService
{
    private readonly HttpClient _http;
    private readonly VibixOptions _options;
    private readonly ILogger<VibixCatalogService> _logger;

    private const int MaxPageSize = 50;
    private static readonly TimeSpan PageDelay = TimeSpan.FromMilliseconds(2000);
    private static readonly TimeSpan DetailsDelay = TimeSpan.FromMilliseconds(1500);
    private const int MaxRetriesOn429 = 3;
    private static readonly TimeSpan MaxRetryAfter = TimeSpan.FromSeconds(60);

    public VibixCatalogService(
        HttpClient http,
        IOptions<VibixOptions> options,
        ILogger<VibixCatalogService> logger)
    {
        _http = http;
        _options = options.Value;
        _logger = logger;

        var baseUrl = string.IsNullOrWhiteSpace(_options.BaseUrl)
            ? "https://vibix.org"
            : _options.BaseUrl.TrimEnd('/');

        _http.BaseAddress = new Uri(baseUrl);
        _http.Timeout = TimeSpan.FromMinutes(60);

        if (!string.IsNullOrWhiteSpace(_options.ApiToken))
        {
            _http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", _options.ApiToken.Trim());
        }

        _http.DefaultRequestHeaders.Accept.Clear();
        _http.DefaultRequestHeaders.Accept.Add(
            new MediaTypeWithQualityHeaderValue("application/json"));
    }

    public sealed record CatalogBatch(
        List<VibixVideoDto> Items,
        bool RateLimited,
        DateTime? LastUploadedAt);

    /// <summary>
    /// Загружает только одну страницу каталога. Используется синхронизатором,
    /// чтобы сохранять данные постепенно, не удерживая весь каталог в памяти.
    /// </summary>
    public async Task<CatalogBatch> GetVideosPageAsync(int page, CancellationToken ct = default)
    {
        if (page < 1) page = 1;
        var requested = _options.PageSize > 0 ? _options.PageSize : MaxPageSize;
        var pageSize = Math.Clamp(requested, 1, MaxPageSize);
        var url = $"/api/v1/publisher/videos/links?page={page}&limit={pageSize}&is_uploaded=true";

        try
        {
            var payload = await FetchPageWithRetryAsync(url, page, ct);
            var items = payload?.Data ?? new List<VibixVideoDto>();
            _logger.LogInformation("Vibix: страница {Page} — получено {Count} записей", page, items.Count);
            return new CatalogBatch(items, false, null);
        }
        catch (RateLimitedException ex)
        {
            _logger.LogWarning("Vibix: ограничение частоты на странице {Page}: {Reason}", page, ex.Message);
            return new CatalogBatch(new List<VibixVideoDto>(), true, null);
        }
    }

    // ============================================================
    // ПРОХОД 1: список каталога постранично
    // ============================================================
    public async Task<CatalogBatch> GetVideosBatchAsync(
        DateTime? updatedFrom = null,
        CancellationToken ct = default)
    {
        var result = new List<VibixVideoDto>();
        var requested = _options.PageSize > 0 ? _options.PageSize : MaxPageSize;
        var pageSize = Math.Min(requested, MaxPageSize);

        var page = 1;
        var rateLimited = false;
        DateTime? maxUploadedAt = null;

        while (true)
        {
            ct.ThrowIfCancellationRequested();

            var url = $"/api/v1/publisher/videos/links?page={page}&limit={pageSize}&is_uploaded=true";
            if (updatedFrom.HasValue)
            {
                var iso = updatedFrom.Value.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture);
                url += $"&updated_from={Uri.EscapeDataString(iso)}";
            }

            VibixPaginatedResponse<VibixVideoDto>? payload;
            try
            {
                payload = await FetchPageWithRetryAsync(url, page, ct);
            }
            catch (RateLimitedException ex)
            {
                _logger.LogWarning(
                    "Vibix: 429 на странице {Page}. Останавливаюсь, сохраню {Count} записей.",
                    page, result.Count);
                _logger.LogWarning("Причина: {Reason}", ex.Message);
                rateLimited = true;
                break;
            }
            catch (OperationCanceledException)
            {
                _logger.LogWarning("Vibix: загрузка прервана на странице {Page}", page);
                throw;
            }

            var items = payload?.Data;
            if (items is null || items.Count == 0)
                break;

            result.AddRange(items);
            _logger.LogInformation(
                "Vibix: страница {Page} — получено {Count} записей (всего {Total})",
                page, items.Count, result.Count);

            if (items.Count < pageSize) break;

            page++;
            if (page > 5000) break;

            await Task.Delay(PageDelay, ct);
        }

        return new CatalogBatch(result, rateLimited, maxUploadedAt);
    }

    // ============================================================
    // ПРОХОД 2: детальный запрос по Кинопоиск ID
    // ============================================================
    /// <summary>
    /// Детальный запрос /videos/kp/{kpId}. Возвращает iframe_video_id.
    /// При 429 — выбрасывает RateLimitedException.
    /// При 404 — возвращает null.
    /// </summary>
    public async Task<int?> GetIframeVideoIdByKpAsync(int kpId, CancellationToken ct = default)
    {
        var url = $"/api/v1/publisher/videos/kp/{kpId}";

        try
        {
            using var response = await _http.GetAsync(url, ct);

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                var retryAfter = response.Headers.RetryAfter?.Delta
                                 ?? TimeSpan.FromSeconds(60);

                _logger.LogWarning(
                    "Vibix: 429 на kp={KpId}, Retry-After={Delay:F0} сек",
                    kpId, retryAfter.TotalSeconds);

                if (retryAfter > MaxRetryAfter)
                {
                    throw new RateLimitedException(
                        $"Retry-After={retryAfter.TotalSeconds:F0} сек", retryAfter);
                }

                await Task.Delay(retryAfter, ct);
                return null;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _logger.LogDebug("Vibix: видео kp={KpId} не найдено (404)", kpId);
                return null;
            }

            if (!response.IsSuccessStatusCode)
            {
                _logger.LogWarning(
                    "Vibix: kp={KpId} вернул статус {Status}",
                    kpId, (int)response.StatusCode);
                return null;
            }

            using var doc = await JsonDocument.ParseAsync(
                await response.Content.ReadAsStreamAsync(ct), cancellationToken: ct);

            if (doc.RootElement.ValueKind == JsonValueKind.Object)
            {
                // Актуальная OpenAPI-документация возвращает поле id и iframe_url;
                // старый контракт/версии API могли возвращать iframe_video_id.
                foreach (var field in new[] { "iframe_video_id", "id" })
                {
                    if (!doc.RootElement.TryGetProperty(field, out var prop)) continue;
                    if (prop.ValueKind == JsonValueKind.Number && prop.TryGetInt32(out var number))
                        return number;
                    if (prop.ValueKind == JsonValueKind.String &&
                        int.TryParse(prop.GetString(), out var parsed))
                        return parsed;
                }
            }

            return null;
        }
        catch (HttpRequestException ex)
        {
            _logger.LogWarning(ex, "Vibix: ошибка запроса kp={KpId}", kpId);
            return null;
        }
        finally
        {
            await Task.Delay(DetailsDelay, ct);
        }
    }

    private async Task<VibixPaginatedResponse<VibixVideoDto>?> FetchPageWithRetryAsync(
        string url, int page, CancellationToken ct)
    {
        for (var attempt = 1; attempt <= MaxRetriesOn429; attempt++)
        {
            using var response = await _http.GetAsync(url, ct);

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                var retryAfter = response.Headers.RetryAfter?.Delta
                                 ?? TimeSpan.FromSeconds(Math.Pow(2, attempt));

                if (retryAfter > MaxRetryAfter)
                {
                    throw new RateLimitedException(
                        $"Retry-After={retryAfter.TotalSeconds:F0} сек", retryAfter);
                }

                await Task.Delay(retryAfter, ct);
                continue;
            }

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync(ct);
                _logger.LogError("Vibix: статус {Status} на странице {Page}. Тело: {Body}",
                    (int)response.StatusCode, page, body);
                throw new HttpRequestException(
                    $"Vibix API вернул {(int)response.StatusCode}.");
            }

            var contentType = response.Content.Headers.ContentType?.MediaType;
            if (contentType is null ||
                !contentType.Contains("json", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException(
                    $"Vibix вернул {contentType} вместо JSON.");

            try
            {
                return await response.Content
                    .ReadFromJsonAsync<VibixPaginatedResponse<VibixVideoDto>>(ct);
            }
            catch (JsonException ex)
            {
                var raw = await response.Content.ReadAsStringAsync(ct);
                _logger.LogError(ex, "JSON от Vibix не разобран. Начало: {Body}",
                    raw.Length > 400 ? raw.Substring(0, 400) : raw);
                throw;
            }
        }

        throw new RateLimitedException(
            $"Не удалось получить страницу {page} после {MaxRetriesOn429} попыток.",
            TimeSpan.Zero);
    }
}

public sealed class RateLimitedException : Exception
{
    public TimeSpan RetryAfter { get; }
    public RateLimitedException(string message, TimeSpan retryAfter) : base(message)
    {
        RetryAfter = retryAfter;
    }
}

public sealed class VibixPaginatedResponse<T>
{
    [JsonPropertyName("data")] public List<T>? Data { get; set; }
    [JsonPropertyName("success")] public bool Success { get; set; }
    [JsonPropertyName("message")] public string? Message { get; set; }
}

public sealed class VibixVideoDto
{
    [JsonPropertyName("id")] public int Id { get; set; }
    [JsonPropertyName("name")] public string? Name { get; set; }
    [JsonPropertyName("name_rus")] public string? NameRus { get; set; }
    [JsonPropertyName("name_eng")] public string? NameEng { get; set; }
    [JsonPropertyName("name_original")] public string? NameOriginal { get; set; }
    [JsonPropertyName("type")] public string? Type { get; set; }

    [JsonPropertyName("year")] public JsonElement? YearRaw { get; set; }
    [JsonPropertyName("uploaded_at")] public string? UploadedAtRaw { get; set; }

    [JsonIgnore] public int? Year => int.TryParse(ScalarToString(YearRaw), out var y) ? y : (int?)null;
    [JsonIgnore] public DateTime? UploadedAt => ParseVibixDate(UploadedAtRaw);

    [JsonPropertyName("kp_id")] public int? KpId { get; set; }
    [JsonPropertyName("kinopoisk_id")] public int? KinopoiskIdLegacy { get; set; }
    [JsonPropertyName("imdb_id")] public string? ImdbId { get; set; }

    [JsonPropertyName("kp_rating")] public JsonElement? KpRatingRaw { get; set; }
    [JsonPropertyName("imdb_rating")] public JsonElement? ImdbRatingRaw { get; set; }
    [JsonPropertyName("kp_votes")] public int? KpVotes { get; set; }
    [JsonPropertyName("imdb_votes")] public int? ImdbVotes { get; set; }

    [JsonIgnore] public decimal? KpRating => ParseDecimal(ScalarToString(KpRatingRaw));
    [JsonIgnore] public decimal? ImdbRating => ParseDecimal(ScalarToString(ImdbRatingRaw));

    [JsonPropertyName("poster_url")] public string? PosterUrl { get; set; }
    [JsonPropertyName("backdrop_url")] public string? BackdropUrl { get; set; }
    [JsonPropertyName("iframe_url")] public string? IframeUrl { get; set; }
    [JsonPropertyName("quality")] public string? Quality { get; set; }
    [JsonPropertyName("duration")] public int? Duration { get; set; }

    [JsonPropertyName("genre")] public JsonElement? GenreRaw { get; set; }
    [JsonPropertyName("country")] public JsonElement? CountryRaw { get; set; }

    [JsonIgnore] public List<string> GenreList => ParseStringOrArray(GenreRaw);
    [JsonIgnore] public List<string> CountryList => ParseStringOrArray(CountryRaw);

    [JsonPropertyName("description")] public string? Description { get; set; }
    [JsonPropertyName("description_short")] public string? DescriptionShort { get; set; }
    [JsonPropertyName("voiceovers")] public List<VibixVoiceoverDto>? Voiceovers { get; set; }
    [JsonPropertyName("iframe_video_id")] public int? IframeVideoId { get; set; }

    /// <summary>
    /// episodes = { "s1": { "e1": { "v1": 8636, "v12": 206687 } } }
    /// </summary>
    [JsonPropertyName("episodes")]
    public Dictionary<string, Dictionary<string, Dictionary<string, int>>>? Episodes { get; set; }

    private static List<string> ParseStringOrArray(JsonElement? element)
    {
        if (element is null) return new List<string>();
        var el = element.Value;

        if (el.ValueKind == JsonValueKind.Null || el.ValueKind == JsonValueKind.Undefined)
            return new List<string>();

        if (el.ValueKind == JsonValueKind.String)
        {
            var s = el.GetString();
            return string.IsNullOrWhiteSpace(s)
                ? new List<string>()
                : s.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        }

        if (el.ValueKind == JsonValueKind.Array)
        {
            var list = new List<string>();
            foreach (var item in el.EnumerateArray())
            {
                if (item.ValueKind == JsonValueKind.String)
                {
                    var s = item.GetString();
                    if (!string.IsNullOrWhiteSpace(s)) list.Add(s.Trim());
                }
            }
            return list;
        }

        return new List<string>();
    }

    private static string? ScalarToString(JsonElement? value)
    {
        if (value is null) return null;
        var element = value.Value;
        return element.ValueKind switch
        {
            JsonValueKind.String => element.GetString(),
            JsonValueKind.Number => element.GetRawText(),
            JsonValueKind.True => "true",
            JsonValueKind.False => "false",
            _ => null
        };
    }

    private static decimal? ParseDecimal(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        return decimal.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var d)
            ? d : (decimal?)null;
    }

    private static DateTime? ParseVibixDate(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;

        string[] formats =
        {
            "yyyy-MM-ddTHH:mm:ss", "yyyy-MM-ddTHH:mm:ss.fff",
            "yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd HH:mm:ss.fff",
            "yyyy-MM-dd",
            "dd.MM.yyyy HH:mm:ss", "dd.MM.yyyy HH:mm", "dd.MM.yyyy"
        };

        if (DateTime.TryParseExact(raw, formats, CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var dt))
            return dt;

        if (DateTime.TryParse(raw, CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out dt))
            return dt;

        return null;
    }
}

public sealed class VibixVoiceoverDto
{
    [JsonPropertyName("id")] public int Id { get; set; }
    [JsonPropertyName("name")] public string? Name { get; set; }
}